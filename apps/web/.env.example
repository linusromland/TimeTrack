# TimeTrack Web Development Environment Variables

# API Base URL - for production, this will be same domain
# For development, Vite proxy handles /api routes to localhost:8080
VITE_API_BASE_URL=http://localhost:8080/api/v1

# App Configuration
VITE_APP_NAME=TimeTrack
VITE_APP_VERSION=0.6.3

# Development settings
# Set to 'development' for more verbose logging
NODE_ENV=development